<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Pandai Brand</title>
    
    <!-- Google Fonts: Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS (Gunakan CDN untuk pembangunan, atau install via npm untuk production) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        pandaiBlue: '#0E3563',
                        pandaiYellow: '#FFD100',
                        pandaiDark: '#0A243F',
                        pandaiLight: '#F8F9FA'
                    },
                    fontFamily: { sans: ['Poppins', 'sans-serif'] }
                }
            }
        }
    </script>
</head>
<body class="bg-white flex flex-col min-h-screen text-gray-800">

    <!-- Sticky Navbar -->
    <header class="sticky top-0 z-50 bg-white shadow-md">
       <!-- Masukkan kod <header> dari jawapan sebelum ini di sini -->
    </header>

    <!-- KANDUNGAN HALAMAN AKAN DIPAPARKAN DI SINI -->
    @RenderBody()

    <!-- Footer -->
    <footer class="bg-pandaiDark text-gray-300 py-16">
       <!-- Masukkan kod <footer> dari jawapan sebelum ini di sini -->
    </footer>

</body>
</html>
